<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="script.opensubtitles.e2ehelper"
       name="OpenSubtitles E2E Helper"
       version="1.0.0"
       provider-name="opensubtitles">
	<requires>
		<import addon="xbmc.python" version="3.0.0"/>
	</requires>
	<extension point="xbmc.python.script" library="default.py" />
	<extension point="xbmc.addon.metadata">
		<summary lang="en_GB">Lets the end-to-end test driver do the few things JSON-RPC cannot: run a built-in, and read or write the target add-on's settings. CI-only, never shipped.</summary>
		<platform>all</platform>
		<license>GPL-2.0-only</license>
	</extension>
</addon>
